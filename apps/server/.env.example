# Copy to apps/server/.env for local runs. On a hosting provider, set these as environment variables.

# Port to listen on. Most hosts inject this automatically.
PORT=3001

# Signs every device's credential. Set this to a long random value and never change it: changing it
# makes every phone and laptop pair again. With it set, a relay that restarts on an empty disk (as free
# hosting does) keeps working. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
RELAY_SECRET=

# Where pairings are stored. Point this at a persistent volume, or every phone must re-pair after a redeploy.
# DATA_DIR=/data

# Number of reverse proxies in front of the server. Set to 1 on Render, Railway, Fly.io and similar hosts,
# otherwise every visitor shares one IP address and hits the rate limits together.
TRUST_PROXY=0

# Comma-separated origins allowed to call the API from another site. Leave empty when this server
# hosts the phone app itself, which is the default setup.
# CORS_ORIGINS=https://scanner.example.com
