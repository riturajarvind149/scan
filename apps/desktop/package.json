{
  "name": "@qr2win/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Receive QR codes scanned on your phone on your Windows 11 desktop.",
  "author": "QR-to-Windows-11",
  "main": "dist/main/index.js",
  "qr2win": {
    "defaultRelayUrl": "https://scan-52rh.onrender.com"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package": "node build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@qr2win/relay-core": "*",
    "@qr2win/shared-types": "*",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "typescript": "^5.5.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.qr2win.desktop",
    "productName": "QR-to-Windows-11",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../web/dist", "to": "web" }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    }
  }
}
